<% content_for :title, "Books - Admin" %>

<div class="admin-content">
  <div class="admin-header">
    <h1>Books Administration</h1>
    <%= link_to "New Book", new_admin_book_path, class: "btn btn-primary" %>
  </div>

  <div class="admin-table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Author</th>
          <th>Genre</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @books.each do |book| %>
          <tr>
            <td><%= book.title %></td>
            <td><%= book.author.full_name %></td>
            <td><%= book.genre %></td>
            <td class="admin-actions">
              <%= link_to "View", admin_book_path(book), class: "btn btn-small btn-secondary" %>
              <%= link_to "Edit", edit_admin_book_path(book), class: "btn btn-small btn-secondary" %>
              <%= link_to "Delete", admin_book_path(book), 
                    data: { "turbo-method": :delete, 
                           confirm: "Are you sure you want to delete this book?" }, 
                    class: "btn btn-small btn-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @books.empty? %>
      <div class="empty-state">
        <p>No books found.</p>
        <%= link_to "Create your first book", new_admin_book_path, class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>