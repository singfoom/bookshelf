<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Admin - Bookshelf" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="with-header admin">
    <header class="header admin-header">
      <div class="header-container">
        <%= link_to "Admin - Bookshelf", admin_root_path, class: "header-logo" %>
        
        <nav class="header-nav">
          <div class="admin-nav">
            <%= link_to "Books", admin_books_path, class: "header-button secondary" %>
            <%= link_to "View Site", root_path, class: "header-button secondary" %>
          </div>
          <div class="header-user">
            <span class="header-username">Admin: <%= current_user.first_name %></span>
            <%= link_to "Sign Out", logout_path, data: { "turbo-method": :delete }, class: "header-button secondary" %>
          </div>
        </nav>
      </div>
    </header>

    <% if flash.any? %>
      <div class="flash-messages">
        <% flash.each do |type, message| %>
          <div class="flash-message <%= type %>">
            <%= message %>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="admin-main">
      <%= yield %>
    </main>
  </body>
</html>